<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>foxglove_bridge</name>
  <version>0.1.0</version>
  <description>Foxglove WebSocket Telemetry Bridge Node for Smart Factory Twin</description>
  <maintainer email="dev-kibeom@example.com">박기범</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>shared_interfaces</depend>
  <depend>nlohmann_json</depend>
  <depend>websocketpp</depend>
  <depend>boost</depend>
  <depend>asio</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
