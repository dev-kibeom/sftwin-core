# Cloud Database Credentials (IDD v4.0 4.2절)
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=sftwin_db
MYSQL_USER=sftwin_admin
MYSQL_PASSWORD=your_admin_password_here

# Edge Infrastructure Secrets
REDIS_PASSWORD=your_redis_password_here
INFLUXDB_ADMIN_TOKEN=your_influxdb_admin_token_here

# Security Encryption Keys
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32bytes_long
AES_256_ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here
