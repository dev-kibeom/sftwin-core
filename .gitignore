# Security & Local Environment Variables
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx

# Documents (모든 하위 디렉토리 내 PDF 포함)
**/documents/*.pdf

# Host Persistent Data Directory
**/data/assets/*
!**/data/assets/aas/sample_aas.json
**/data/raw/*
**/data/sim_packages/*
**/data/runtime/storage/mysql/*
**/data/runtime/storage/redis/*
**/data/runtime/storage/influxdb/*
**/data/runtime/logs/*
!**/data/**/.gitkeep

# ROS 2 Build Artifacts & Workspace
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
ros2_ws/.colcon/
ros2_ws/.colcon_install_layout
ros2_ws/COLCON_IGNORE
COLCON_IGNORE

# C++ Build Artifacts (Edge & Physics Engine)
build/
bin/
lib/
*.o
*.obj
*.so
*.dylib
*.a

# Python Artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Simulation & Cache Artifacts
*.bag
*.mcap
*.log

# IDE & OS Specific
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary Backup Folder
_backup/
