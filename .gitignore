# ==========================================
# Security & Local Environment Variables
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx

# ==========================================
# Documents
# ==========================================
**/documents/*.pdf

# ==========================================
# Host Persistent Data Directory
# ==========================================
**/data/assets/*
!**/data/assets/aas/
!**/data/assets/aas/sample_aas.json
**/data/raw/*
**/data/sim_packages/*
**/data/runtime/storage/mysql/*
**/data/runtime/storage/redis/*
**/data/runtime/storage/influxdb/*
**/data/runtime/logs/*
!**/data/**/.gitkeep

# ==========================================
# ROS 2 Build Artifacts & Workspace
# ==========================================
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
ros2_ws/.colcon/
ros2_ws/.colcon_install_layout
ros2_ws/COLCON_IGNORE
COLCON_IGNORE

# ==========================================
# web_ui 폴더 전용 설정
# ==========================================
web_ui/node_modules/
node_modules/
web_ui/dist/
web_ui/dist-ssr/
web_ui/*.local

# ==========================================
# C++ Build Artifacts
# ==========================================
build/
bin/
lib/
*.o
*.obj
*.so
*.dylib
*.a

# ==========================================
# Python Artifacts
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ==========================================
# Simulation & ROS Bag Cache
# ==========================================
*.bag
*.mcap
*.db3
*.log
# Gazebo / Ignition 로그 및 런타임 캐시
.ignition/
.gazebo/
.gz/

# ==========================================
# IDE & OS Specific (Global)
# ==========================================
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tsbuildinfo

# VSCode: 기본 설정은 무시하되 extensions.json 공유 허용
.vscode/*
!.vscode/extensions.json
!web_ui/.vscode/extensions.json

# Temporary Backup Folder
_backup/
