# Security & Local Environment Variables (IDD v4.0 4.2절)
.env.local
*.pem
*.key
*.pfx

# documents (모든 하위 디렉토리 내 PDF 포함)
**/documents/*.pdf

# Host Persistent Data Directory
**/data/assets/*
**/data/raw/*
**/data/sim_packages/*
**/data/runtime/storage/mysql/*
**/data/runtime/storage/redis/*
**/data/runtime/storage/influxdb/*
**/data/runtime/logs/*
!**/data/**/.gitkeep

# Keep data folder structure via .gitkeep
!data/**/.gitkeep

# Python Artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/

# C++ Build Artifacts (Edge & Physics Engine)
build/
bin/
lib/
*.o
*.obj
*.so
*.dylib

# IDE & OS Specific
.vscode/
.idea/
.DS_Store
Thumbs.db
# Temporary Backup Folder
_backup/
