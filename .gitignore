# Security & Local Environment Variables
.env.local
.env.*.local
*.pem
*.key
*.pfx

# documents (모든 하위 디렉토리 내 PDF 포함)
**/documents/*.pdf

# Host Persistent Data Directory
**/data/assets/*
!**/data/assets/aas/sample_aas.json
**/data/raw/*
**/data/sim_packages/*
**/data/runtime/storage/mysql/*
**/data/runtime/storage/redis/*
**/data/runtime/storage/influxdb/*
**/data/runtime/logs/*
!**/data/**/.gitkeep

# Python Artifacts
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# C++ Build Artifacts (Edge & Physics Engine)
build/
bin/
lib/
*.o
*.obj
*.so
*.dylib
*.a

# IDE & OS Specific
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary Backup Folder
_backup/
